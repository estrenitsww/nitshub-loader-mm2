local function toggleMenu(open)
    if open then
        MainMenu.Visible = true
        MainMenu.Size = UDim2.new(0, 0, 0, 0)
        MainMenu.Position = UDim2.new(0.5, 0, 0.5, 0)
        
        local menuTween = TweenService:Create(MainMenu, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 480, 0, 320),
            Position = UDim2.new(0.5, -240, 0.5, -160)
        })
        local buttonTween = TweenService:Create(FloatingButton, TweenInfo.new(0.2), {ImageTransparency = 1})
        
        menuTween:Play()
        buttonTween:Play()
        buttonTween.Completed:Connect(function() FloatingButton.Visible = false end)
    else
        FloatingButton.Visible = true
        local buttonTween = TweenService:Create(FloatingButton, TweenInfo.new(0.2), {ImageTransparency = 0})
        
        local menuTween = TweenService:Create(MainMenu, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        
        buttonTween:Play()
        menuTween:Play()
        menuTween.Completed:Connect(function() MainMenu.Visible = false end)
    end
end

FloatingButton.MouseButton1Click:Connect(function() toggleMenu(true) end)
CloseButton.MouseButton1Click:Connect(function() toggleMenu(false) end)

local Toggles = {
    SilentAim = false, AutoShoot = false, Aimbot = false, TriggerBot = false,
    WallCheck = false, GrabGun = false, ThrowAimbot = false, KillAll = false,
    AutoThrow = false, ESP = false
}
local Colors = {
    Murder = Color3.fromRGB(255, 0, 0),
    Sheriff = Color3.fromRGB(0, 0, 255),
    Hero = Color3.fromRGB(255, 255, 0),
    Innocent = Color3.fromRGB(0, 255, 0)
}

local function getMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and (p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")) then
            return p
        end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    local m = getMurderer()
    if not m or not m.Character or not m.Character:FindFirstChild("Head") then return end
    
    if Toggles.SilentAim or Toggles.Aimbot then
        local myChar = LocalPlayer.Character
        local gun = myChar and (myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Pistol"))
        if gun and Toggles.AutoShoot then
            local targetHead = m.Character.Head
            if Toggles.TriggerBot then
                targetHead.CFrame = targetHead.CFrame * CFrame.new(0, 0, 1)
            end
        end
    end
    
    if Toggles.GrabGun then
        local drop = Workspace:FindFirstChild("GunDrop")
        if drop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = drop.CFrame + Vector3.new(0, 2, 0)
        end
    end
end)

local function actualizarESP()
    if not Toggles.ESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("NitsESP") then
                p.Character["NitsESP"]:Destroy()
            end
        end
        return
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local highlight = p.Character:FindFirstChild("NitsESP") or Instance.new("Highlight")
            highlight.Name = "NitsESP"
            highlight.Parent = p.Character
            highlight.FillTransparency = 0.4
            
            local isMurder = p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")
            local isSheriff = p.Character:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")
            local esHeroe = isSheriff and p.Name ~= "Sheriff"
            
            if isMurder then
                highlight.FillColor = Colors.Murder
            elseif esHeroe then
                highlight.FillColor = Colors.Hero
            elseif isSheriff then
                highlight.FillColor = Colors.Sheriff
            else
                highlight.FillColor = Colors.Innocent
            end
            highlight.OutlineColor = highlight.FillColor
        end
    end
end

task.spawn(function()
    while task.wait(1) do
        actualizarESP()
    end
end)

local function crearBotonMenu(texto, estadoInicial, callback, padre)
    local btn = Instance.new("TextButton")
    btn.Text = texto .. ": " .. (estadoInicial and "ON" or "OFF")
    btn.BackgroundColor3 = estadoInicial and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = padre
    
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = btn
    
    local activo = estadoInicial
    btn.MouseButton1Click:Connect(function()
        activo = not activo
        btn.Text = texto .. ": " .. (activo and "ON" or "OFF")
        btn.BackgroundColor3 = activo and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(60, 60, 60)
        callback(activo)
    end)
    return btn
end

